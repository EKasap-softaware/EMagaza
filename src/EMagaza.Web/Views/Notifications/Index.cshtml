@model IReadOnlyList<Notification>
@{
    ViewData["Title"] = "Bildirimler";
    static string Icon(string kind) => kind switch { "paid" => "💳", "preparing" => "📦", "shipped" => "🚚", "delivered" => "🎁", "cancelled" => "↩️", _ => "🔔" };
}
<div class="wrap">
    <div class="page-head"><h1>Bildirimler</h1><p class="muted">Siparişlerinle ilgili tüm gelişmeler burada.</p></div>
    <div class="notif-list">
        @if (Model.Count == 0)
        {
            <div class="empty"><h3>Henüz bildirimin yok</h3><p>Sipariş verdiğinde ödeme ve kargo bildirimlerin burada görünür.</p></div>
        }
        @foreach (var n in Model)
        {
            <div class="notif @(n.IsRead ? "" : "unread")">
                <div class="n-ico">@Icon(n.Kind)</div>
                <div>
                    <h4>@n.Title</h4>
                    <p>@n.Message</p>
                    <a class="n-no" asp-controller="Orders" asp-action="Detail" asp-route-id="@n.OrderId">Sipariş no: @n.OrderNumber →</a>
                </div>
                <time>@Fmt.Date(n.CreatedAt)</time>
            </div>
        }
    </div>
</div>
