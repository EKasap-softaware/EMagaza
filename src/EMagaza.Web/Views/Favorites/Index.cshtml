@model IReadOnlyList<Product>
@{ ViewData["Title"] = "Favorilerim"; }
<div class="wrap">
    <div class="page-head"><h1>Favorilerim <small class="muted" style="font-family:var(--sans);font-size:16px">(@Model.Count)</small></h1></div>
    @if (Model.Count == 0)
    {
        <div class="empty"><h3>Henüz favorin yok</h3><p>Beğendiğin ürünlerin kalp simgesine tıkla, burada sakla.</p><a class="btn btn-dark" asp-controller="Shop" asp-action="Index">Alışverişe başla</a></div>
    }
    else
    {
        <div class="grid">
            @foreach (var p in Model)
            {
                <div>
                    <partial name="_ProductCard" model="p" />
                    <form asp-action="Toggle" method="post" style="margin-top:8px">
                        <input type="hidden" name="productId" value="@p.Id" /><input type="hidden" name="fromList" value="true" />
                        <button class="linkbtn">Favorilerden çıkar</button>
                    </form>
                </div>
            }
        </div>
    }
</div>
