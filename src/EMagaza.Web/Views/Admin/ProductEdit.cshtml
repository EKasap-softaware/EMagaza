@model ProductForm
@{
    var isNew = string.IsNullOrEmpty(Model.Id);
    ViewData["Title"] = isNew ? "Yeni ürün" : "Ürünü düzenle";
}
<div class="wrap" style="max-width:820px">
    <a class="back" asp-action="Products">← Ürünlere dön</a>
    <div class="page-head" style="padding-top:12px"><h1>@ViewData["Title"]</h1></div>

    <form method="post" asp-action="ProductEdit" class="panel">
        <input type="hidden" asp-for="Id" />
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.TryGetValue("", out var general) && general.Errors.Count > 0) { <div class="alert alert-bad">@general.Errors[0].ErrorMessage</div> }

        <div class="row2">
            <div class="field"><label asp-for="Name">Ürün adı</label><input asp-for="Name" /><span asp-validation-for="Name" class="field-error"></span></div>
            <div class="field"><label asp-for="Brand">Marka</label><input asp-for="Brand" /><span asp-validation-for="Brand" class="field-error"></span></div>
        </div>
        <div class="row2">
            <div class="field"><label asp-for="Category">Kategori</label>
                <select asp-for="Category">@foreach (var c in new[] { "Kadın", "Erkek", "Aksesuar" }) { <option value="@c" selected="@(Model.Category == c)">@c</option> }</select></div>
            <div class="field"><label asp-for="Type">Ürün tipi (görsel)</label>
                <select asp-for="Type">@foreach (var t in GarmentShapes.All.Keys) { <option value="@t" selected="@(Model.Type == t)">@Garments.Label(t)</option> }</select></div>
        </div>
        <div class="row3">
            <div class="field"><label asp-for="ColorName">Renk adı</label><input asp-for="ColorName" /><span asp-validation-for="ColorName" class="field-error"></span></div>
            <div class="field"><label asp-for="ColorHex">Renk kodu</label><input asp-for="ColorHex" type="color" style="height:46px;padding:4px" /><span asp-validation-for="ColorHex" class="field-error"></span></div>
            <div class="field"><label asp-for="IsNew">Yeni sezon</label><select asp-for="IsNew"><option value="false">Hayır</option><option value="true" selected="@Model.IsNew">Evet</option></select></div>
        </div>
        <div class="row2">
            <div class="field"><label asp-for="Price">Fiyat (₺)</label><input asp-for="Price" type="number" step="0.01" /><span asp-validation-for="Price" class="field-error"></span></div>
            <div class="field"><label asp-for="OldPrice">Eski fiyat (indirim yoksa 0)</label><input asp-for="OldPrice" type="number" step="0.01" /><span asp-validation-for="OldPrice" class="field-error"></span></div>
        </div>
        <div class="field"><label asp-for="SizesText">Bedenler ve stok</label><input asp-for="SizesText" placeholder="XS:5, S:10, M:8, L:0" /><small class="muted">Biçim: beden:stok, virgülle ayır. Aksesuar için: Tek Beden:10</small><span asp-validation-for="SizesText" class="field-error"></span></div>
        <div class="field"><label asp-for="Description">Açıklama</label><textarea asp-for="Description" rows="3"></textarea></div>
        <div class="field"><label asp-for="Material">Kumaş / bakım</label><input asp-for="Material" /></div>
        <button class="btn btn-dark">Kaydet</button>
    </form>
</div>
