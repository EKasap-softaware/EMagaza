@model Product
@{
    ViewData["Title"] = Model.Name;
    var reviews = ViewBag.Reviews as IReadOnlyList<Review> ?? Array.Empty<Review>();
    var related = ViewBag.Related as IReadOnlyList<Product> ?? Array.Empty<Product>();
    var avg = Model.RatingAverage;
}
<div class="wrap">
    <div class="crumbs" style="padding-top:26px">
        <a asp-controller="Home" asp-action="Index">Ana sayfa</a> /
        <a asp-controller="Shop" asp-action="Index" asp-route-category="@Model.Category">@Model.Category</a> / @Model.Name
    </div>

    <div class="pdp">
        <div class="pdp-gallery">
            <div class="pdp-img" style="background:@Garments.Tint(Model.ColorHex)">
                @Garments.Svg(Model.Type, Model.ColorHex)
                <div class="tags">
                    @if (Model.OnSale) { <span class="tag tag-sale">%@Model.DiscountPercent indirim</span> }
                    @if (Model.IsNew) { <span class="tag tag-new">Yeni sezon</span> }
                </div>
            </div>
        </div>

        <div class="pdp-info">
            <div style="display:flex;justify-content:space-between;align-items:center">
                <div class="pbrand">@Model.Brand · @Garments.Label(Model.Type)</div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var isFavorite = ViewBag.IsFavorite == true;
                    <form asp-controller="Favorites" asp-action="Toggle" method="post">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <button class="heart @(isFavorite ? "on" : "")" title="@(isFavorite ? "Favorilerden çıkar" : "Favorilere ekle")" aria-label="Favori">
                            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M12 21s-7-4.6-9.3-9.1C1.3 8.9 2.9 5 6.6 5c2 0 3.4 1.1 5.4 3.2C14 6.1 15.4 5 17.4 5c3.7 0 5.3 3.9 3.9 6.9C19 16.4 12 21 12 21z"/></svg>
                        </button>
                    </form>
                }
            </div>
            <h1>@Model.Name</h1>
            <div class="pdp-price"><span class="@(Model.OnSale ? "sale-price" : "")">@Fmt.Money(Model.Price)</span>@if (Model.OnSale) { <span class="old">@Fmt.Money(Model.OldPrice)</span> }</div>
            @if (Model.ReviewCount > 0)
            {
                <div class="rating">@(new string('★', (int)Math.Round(avg)))@(new string('☆', 5 - (int)Math.Round(avg)))<small>@avg.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) · @Model.ReviewCount yorum</small></div>
            }
            <p class="muted">@Model.Description</p>
            <div class="opt-label">Renk <span><i class="swatch" style="background:@Model.ColorHex"></i>@Model.ColorName</span></div>

            <form asp-controller="Cart" asp-action="Add" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="opt-label">Beden <span>Stokta olmayan bedenler seçilemez</span></div>
                <div class="sizes">
                    @foreach (var s in Model.Sizes)
                    {
                        <label class="size">
                            <input type="radio" name="size" value="@s.Size" required disabled="@(s.Stock == 0)" />
                            <span>@s.Size</span>
                            @if (s.Stock is > 0 and <= 3) { <em class="low">Son @s.Stock</em> }
                        </label>
                    }
                </div>
                <div class="buy-row">
                    <select name="quantity" class="select" aria-label="Adet">@for (var i = 1; i <= 5; i++) { <option value="@i">@i adet</option> }</select>
                    <button class="btn btn-dark btn-block" disabled="@(Model.TotalStock == 0)">@(Model.TotalStock == 0 ? "Tükendi" : "Sepete ekle")</button>
                </div>
            </form>

            <div class="assure">
                <span>✓ 1.500 ₺ üzeri siparişlerde ücretsiz kargo</span>
                <span>✓ 14 gün içinde ücretsiz iade</span>
                <span>✓ Güvenli ödeme · siparişin her adımında bildirim</span>
            </div>

            <details class="acc" open><summary>Ürün detayı</summary><p>@Model.Description Kalıp ve beden için standart ölçülere uygundur.</p></details>
            <details class="acc"><summary>Kumaş &amp; bakım</summary><p>@Model.Material. 30° yıkayın, ters çevirerek ütüleyin, çamaşır suyu kullanmayın.</p></details>
            <details class="acc"><summary>Teslimat &amp; iade</summary><p>Siparişin 1-3 iş gününde kargoya verilir. 14 gün içinde kullanılmamış ürünleri ücretsiz iade edebilirsin.</p></details>
        </div>
    </div>

    <section class="reviews">
        <h2 style="font-size:36px">Yorumlar</h2>
        <div class="reviews-grid">
            <div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Reviews" asp-action="Add" method="post" class="panel">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <div class="field"><label>Puanın</label>
                            <select name="rating">@for (var i = 5; i >= 1; i--) { <option value="@i">@(new string('★', i))@(new string('☆', 5 - i))</option> }</select></div>
                        <div class="field"><label>Yorumun</label><textarea name="comment" rows="4" required placeholder="Kalıp, kumaş, beden hakkında…"></textarea></div>
                        <button class="btn btn-dark">Yorumu gönder</button>
                    </form>
                }
                else { <div class="panel"><p class="muted">Yorum yazmak için <a class="text-link" style="text-decoration:underline" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">giriş yap</a>.</p></div> }
            </div>
            <div>
                @if (ViewBag.ReviewsError == true) { <p class="muted">Yorumlar şu an yüklenemiyor.</p> }
                else if (reviews.Count == 0) { <p class="muted">Henüz yorum yok. İlk yorumu sen yaz.</p> }
                @foreach (var r in reviews)
                {
                    <div class="review"><b>@r.Author</b><span class="stars">@(new string('★', r.Rating))</span> <small class="muted">@Fmt.ShortDate(r.CreatedAt)</small><div>@r.Comment</div></div>
                }
            </div>
        </div>
    </section>

    @if (related.Count > 0)
    {
        <section class="section" style="padding-top:20px">
            <div class="sec-head"><h2>Bunları da beğenebilirsin</h2></div>
            <div class="grid">@foreach (var p in related) { <partial name="_ProductCard" model="p" /> }</div>
        </section>
    }
</div>
